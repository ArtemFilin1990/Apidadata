# Required
BOT_TOKEN=1234567890:replace_with_bot_token
DADATA_API_KEY=replace_with_dadata_api_key

# Runtime mode: webhook (Render/Amvera) or polling (Replit)
RUN_MODE=webhook

# Required only when RUN_MODE=webhook
WEBHOOK_BASE_URL=https://example.onrender.com
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_16_chars

# Optional
WEBHOOK_PATH=/telegram/webhook
HOST=0.0.0.0
PORT=80
CACHE_TTL_SECONDS=21600
SESSION_TTL_SECONDS=7200
DADATA_RPS_LIMIT=8
DADATA_MAX_CONNECTIONS=10
REQUEST_TIMEOUT_SECONDS=10
DROP_PENDING_UPDATES=false
LOG_LEVEL=INFO

# Storage backend: memory | redis | sqlite
STORAGE_BACKEND=sqlite
REDIS_URL=
SQLITE_PATH=.data/bot-storage.db

# Optional Checko fallback (used only if DaData returns empty result)
CHECKO_API_KEY=
CHECKO_BASE_URL=https://api.checko.ru/v2

PYTHONUNBUFFERED=1
