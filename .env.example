# Required
BOT_TOKEN=1234567890:replace_with_bot_token
DADATA_API_KEY=replace_with_dadata_api_key
WEBHOOK_BASE_URL=https://example.amvera.io
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_16_chars

# Optional
WEBHOOK_PATH=/telegram/webhook
HOST=0.0.0.0
PORT=80
CACHE_TTL_SECONDS=21600
SESSION_TTL_SECONDS=7200
DADATA_RPS_LIMIT=8
DADATA_MAX_CONNECTIONS=10
REQUEST_TIMEOUT_SECONDS=10
REDIS_URL=
DROP_PENDING_UPDATES=false
LOG_LEVEL=INFO
