# Required
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
DADATA_API_KEY=YOUR_DADATA_API_KEY_HERE

WEBHOOK_BASE_URL=https://your-domain.example.com
TELEGRAM_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_MIN_16_CHARS


# Optional
WEBHOOK_PATH=/telegram/webhook
HOST=0.0.0.0
PORT=80
CACHE_TTL_SECONDS=21600
SESSION_TTL_SECONDS=7200
DADATA_RPS_LIMIT=8
DADATA_MAX_CONNECTIONS=10
REQUEST_TIMEOUT_SECONDS=10
REDIS_URL=
DROP_PENDING_UPDATES=false
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
