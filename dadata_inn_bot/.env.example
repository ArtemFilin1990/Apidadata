# Telegram
BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_me_with_random_string
WEBHOOK_BASE_URL=https://your-project.amvera.io
WEBHOOK_PATH=/telegram/webhook

# DaData
DADATA_API_KEY=replace_me

# Cache and limits
CACHE_TTL_SECONDS=21600
SESSION_TTL_SECONDS=7200
DADATA_RPS_LIMIT=8
DADATA_MAX_CONNECTIONS=10
REQUEST_TIMEOUT_SECONDS=10
REDIS_URL=

# Runtime
HOST=0.0.0.0
PORT=80
DROP_PENDING_UPDATES=false
LOG_LEVEL=INFO
